USE DataSalud_Peru;
GO

-- 1. Crear los tres roles
IF NOT EXISTS (
    SELECT 1 FROM sys.database_principals
    WHERE name = 'Rol_Administrador'
)
    CREATE ROLE Rol_Administrador;
GO

IF NOT EXISTS (
    SELECT 1 FROM sys.database_principals
    WHERE name = 'Rol_Analista'
)
    CREATE ROLE Rol_Analista;
GO

IF NOT EXISTS (
    SELECT 1 FROM sys.database_principals
    WHERE name = 'Rol_Auditor'
)
    CREATE ROLE Rol_Auditor;
GO

-- 2. Asignar permisos
GRANT SELECT, INSERT, UPDATE, DELETE
ON dbo.SaludMentalValidada
TO Rol_Administrador;

GRANT EXECUTE
ON dbo.sp_CargarSaludMental
TO Rol_Administrador;

GRANT SELECT
ON dbo.SaludMentalValidada
TO Rol_Analista;

GRANT SELECT
ON dbo.AuditoriaSalud
TO Rol_Auditor;
GO

-- 3. Crear usuarios de prueba
IF NOT EXISTS (
    SELECT 1 FROM sys.database_principals
    WHERE name = 'Usuario_Admin'
)
    CREATE USER Usuario_Admin WITHOUT LOGIN;
GO

IF NOT EXISTS (
    SELECT 1 FROM sys.database_principals
    WHERE name = 'Usuario_Analista'
)
    CREATE USER Usuario_Analista WITHOUT LOGIN;
GO

IF NOT EXISTS (
    SELECT 1 FROM sys.database_principals
    WHERE name = 'Usuario_Auditor'
)
    CREATE USER Usuario_Auditor WITHOUT LOGIN;
GO

-- 4. Asignar los usuarios a los roles
ALTER ROLE Rol_Administrador
ADD MEMBER Usuario_Admin;

ALTER ROLE Rol_Analista
ADD MEMBER Usuario_Analista;

ALTER ROLE Rol_Auditor
ADD MEMBER Usuario_Auditor;
GO

-- 5. Comprobar los permisos asignados
SELECT
    R.name AS Rol,
    M.name AS Usuario
FROM sys.database_role_members RM
INNER JOIN sys.database_principals R
    ON RM.role_principal_id = R.principal_id
INNER JOIN sys.database_principals M
    ON RM.member_principal_id = M.principal_id
WHERE R.name IN (
    'Rol_Administrador',
    'Rol_Analista',
    'Rol_Auditor'
);
GO
